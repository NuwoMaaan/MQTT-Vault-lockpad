# `MQTT_BROKER=broker.emqx.io` provides a cloud connection
# Run hosting the broker locally replace with IP of broker
# MQTT_BROKER=broker.emqx.io | 127.0.0.1 | localhost

# EMQX broker client connection parameters
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=MqttBroker
MQTT_PASSWORD=password

# EMQX provision init parameters
EMQX_URL=http://localhost:18083/api/v5
USER=admin
PASS=password

# Cloud MQTT broker client connection parameters
# MQTT_BROKER=broker.emqx.io
# MQTT_PORT=8883
# MQTT_USERNAME=username
# MQTT_PASSWORD=password