# This file is generated. Do not edit.
# The configs are results of online config changes from UI/API/CLI.
# To persist configs in this file, copy the content to etc/base.hocon.
actions {
  mongodb {
    store_events {
      connector = MongoDB
      enable = true
      parameters {
        collection = events
        payload_template = """{"clientid": "${clientid}", "topic": "${topic}", "qos": "${qos}", "id": "${payload.id}", "event": "${payload.event}", "result": "${payload.result}", "timestamp": "${payload.timestamp}"}"""
      }
    }
    store_metrics {
      connector = MongoDB
      enable = true
      parameters {
        collection = metrics
        payload_template = """{"clientid": "${clientid}", "topic": "${topic}", "qos": "${qos}", "id": "${payload.id}", "cpu": "${payload.cpu}", "temperature": "${payload.temperature}", "timestamp": "${payload.timestamp}"}"""
      }
    }
    store_status {
      connector = MongoDB
      enable = true
      parameters {
        collection = status
        payload_template = """{"clientid": "${clientid}", "topic": "${topic}", "qos": "${qos}", "id": "${payload.id}", "state": "${payload.state}", "last_unlock": "${payload.last_unlock}", "battery": "${payload.battery}", "error": "${payload.error}", "timestamp": "${payload.timestamp}"}"""
      }
    }
  }
}
authentication = [
  {
    backend = built_in_database
    mechanism = password_based
    enable = true

    bootstrap_file = "/opt/emqx/etc/user.json"
  }
]
connectors {
  mongodb {
    MongoDB {
      database = VaultPadlock
      description = ""
      enable = true
      parameters {
        mongo_type = single
        server = mongo
        w_mode = unsafe
      }
      password = password
      pool_size = 8
      resource_opts {
        health_check_interval = "15s"
        health_check_timeout = "60s"
        start_after_created = true
        start_timeout = "5s"
      }
      srv_record = false
      ssl {
        ciphers = []
        depth = 10
        enable = false
        hibernate_after = "5s"
        log_level = notice
        middlebox_comp_mode = true
        reuse_sessions = true
        secure_renegotiate = true
        verify = verify_none
        versions = [
          "tlsv1.3",
          "tlsv1.2"
        ]
      }
      topology {
        heartbeat_frequency_ms = "200s"
        max_overflow = 0
      }
      use_legacy_protocol = auto
      username = admin
    }
  }
}
log {
  console {}
  file {}
}
rule_engine {
  ignore_sys_message = true
  jq_function_default_timeout = "10s"
  rules {
    "8b3584eb" {
      actions = [
        "mongodb:store_metrics"
      ]
      enable = true
      name = vault_metrics_rule
      sql = """~
        SELECT * FROM "vault/padlock/metrics"~"""
    }
    aaf146a2 {
      actions = [
        "mongodb:store_events"
      ]
      enable = true
      name = vault_event_rule
      sql = """~
        SELECT * FROM "vault/padlock/event"~"""
    }
    e7bc952b {
      actions = [
        "mongodb:store_status"
      ]
      enable = true
      name = vault_status_rule
      sql = """~
        SELECT * FROM "vault/padlock/status"~"""
    }
  }
}